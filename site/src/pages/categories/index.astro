---
import Blog from '../../layouts/Blog.astro';
import { terms, taxonomyURL } from '../../lib/content';
const entries = terms('category');
---
<Blog title="分类"><h1>分类</h1><ul class="taxonomy">{entries.map((term) => <li><a href={taxonomyURL(term)}>{term.name}</a></li>)}</ul>{!entries.length && <p>暂无已发布分类。</p>}</Blog>
