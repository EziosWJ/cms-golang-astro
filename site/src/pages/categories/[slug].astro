---
import { CategoryDetailView } from '../../theme';
import { terms } from '../../lib/content';
import { themeSite, themeTaxonomyDetail } from '../../lib/theme-model';
export function getStaticPaths() { return terms('category').map((term) => ({ params: { slug: term.url }, props: { term } })); }
const { term } = Astro.props;
---
<CategoryDetailView site={themeSite} {...themeTaxonomyDetail(term)} />
