---
import { PostArticleView } from '../../theme';
import { articles, renderMarkdown } from '../../lib/content';
import { themeSite, toThemeArticle } from '../../lib/theme-model';
export function getStaticPaths() { return articles.map((article) => ({ params: { slug: article.revision.slug }, props: { article } })); }
const { article } = Astro.props;
const html = await renderMarkdown(article.revision.markdown);
---
<PostArticleView site={themeSite} article={toThemeArticle(article)} html={html} />
