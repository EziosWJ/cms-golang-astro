---
import { PostArticleView } from '../../theme';
import { articles, renderMarkdownDocument } from '../../lib/content';
import { themeArticleContext, themeSite } from '../../lib/theme-model';
export function getStaticPaths() { return articles.map((article) => ({ params: { slug: article.revision.slug }, props: { article } })); }
const { article } = Astro.props;
const document = await renderMarkdownDocument(article.revision.markdown);
const context = themeArticleContext(article, document.headings);
---
<PostArticleView site={themeSite} html={document.html} {...context} />
