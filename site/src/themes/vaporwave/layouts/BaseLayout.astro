---
import '../styles/theme.css';
import type { BaseLayoutProps } from '../../types';
const { site, title, description } = Astro.props as BaseLayoutProps;
const pageTitle = title ? `${title} // ${site.name}` : site.name;
---
<!doctype html><html lang={site.language}><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description ?? site.description} /><title>{pageTitle}</title></head><body><div class="vapor-grid"></div><div class="vapor-shell"><header class="vapor-header"><a class="vapor-logo" href={site.homeUrl}>// {site.name}</a><nav aria-label="主导航"><a href={site.archiveUrl}>ARCHIVE</a><a href={site.categoriesUrl}>CATEGORY</a><a href={site.tagsUrl}>TAGS</a></nav></header><main class="vapor-main"><slot /></main><footer class="vapor-footer"><span>© {site.authorName}</span><span>END OF TRANSMISSION_</span></footer></div></body></html>
