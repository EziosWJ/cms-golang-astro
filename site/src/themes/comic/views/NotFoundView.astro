---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { NotFoundProps } from '../../types';
const { site } = Astro.props as NotFoundProps;
---
<BaseLayout site={site} title="404"><div class="comic-404"><strong>404!</strong><h1>这一格还没有画出来</h1><p>页面不存在，或者已经被移动。</p><a href={site.homeUrl}>返回首页 →</a></div></BaseLayout>
