---
import '../styles/theme.css';
import '../styles/fidelity.css';
import type { BaseLayoutProps } from '../../types';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
const { site, title, description = site.description, type = 'website', canonical, noindex = false } = Astro.props as BaseLayoutProps;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
let currentUrl: string | undefined;
if (site.publicUrl) {
  try { currentUrl = new URL(canonical || Astro.url.pathname, site.publicUrl).href; } catch { currentUrl = canonical; }
} else {
  currentUrl = canonical;
}
const rssUrl = `${site.homeUrl.replace(/\/$/, '')}/rss.xml`;
const sitemapUrl = `${site.homeUrl.replace(/\/$/, '')}/sitemap.xml`;
---
<!doctype html>
<html lang={site.language} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>try{const t=localStorage.getItem('theme');if(t==='dark'||t==='light')document.documentElement.dataset.theme=t}catch{}</script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {site.authorName && <meta name="author" content={site.authorName} />}
    {noindex ? <meta name="robots" content="noindex, follow" /> : currentUrl && <><link rel="canonical" href={currentUrl} /><meta property="og:url" content={currentUrl} /></>}
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} RSS`} href={rssUrl} />
    <link rel="sitemap" type="application/xml" href={sitemapUrl} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23ffcc00' stroke='%231a1a1a' stroke-width='4'/%3E%3Ctext x='16' y='24' font-family='sans-serif' font-size='20' font-weight='900' text-anchor='middle' fill='%231a1a1a'%3EC%3C/text%3E%3C/svg%3E" />
  </head>
  <body>
    <a class="comic-skip" href="#main">跳到正文</a>
    <Nav site={site} />
    <main id="main" class="comic-main"><slot /></main>
    <Footer site={site} />
  </body>
</html>
